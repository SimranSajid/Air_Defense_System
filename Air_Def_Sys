import cv2
import numpy as np
import threading
import asyncio
import json
import time
import websockets
import hand_module as htm

# ── Configuration ──────────────────────────────────────────
ESP8266_IP = "10.67.73.157"
WS_URL = f"ws://{ESP8266_IP}:82"

# Camera settings
wCam, hCam = 640, 480
frameR = 80                        # Region of interest margin

# Servo angle limits
PAN_MIN,  PAN_MAX  = 10, 170
TILT_MIN, TILT_MAX = 10, 110

# Smoothing
ALPHA     = 0.12
DEAD_ZONE = 1.0

# FPS & initial servo position
pTime = 0
plocX, plocY = 90.0, 60.0

# Shared servo state (thread-safe)
latest_pan  = 90.0
latest_tilt = 60.0
servo_lock  = threading.Lock()

# ── WebSocket Sender ────────────────────────────────────────
async def ws_sender():
    last_pan, last_tilt = -1, -1
    print(f"[WS] Connecting to {WS_URL}...")

    while True:
        try:
            async with websockets.connect(WS_URL) as ws:
                print("[WS] Connected")
                while True:
                    with servo_lock:
                        pan  = latest_pan
                        tilt = latest_tilt

                    if (abs(pan - last_pan) > DEAD_ZONE or
                            abs(tilt - last_tilt) > DEAD_ZONE):
                        await ws.send(json.dumps({
                            "pan":  int(round(pan)),
                            "tilt": int(round(tilt))
                        }))
                        last_pan, last_tilt = pan, tilt

                    await asyncio.sleep(0.067)   # ~15 Hz

        except Exception as e:
            print(f"[WS] {e} — retrying...")
            await asyncio.sleep(2)

# Start WebSocket thread (background daemon)
threading.Thread(
    target=lambda: asyncio.run(ws_sender()),
    daemon=True
).start()

# ── Camera Setup ────────────────────────────────────────────
cap = cv2.VideoCapture(0)
cap.set(cv2.CAP_PROP_FRAME_WIDTH,  wCam)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, hCam)
cap.set(cv2.CAP_PROP_FPS, 30)

# Hand detector
detector = htm.HandDetector(maxHands=1, detectionCon=0.8, trackCon=0.8)

print("[SYS] Laptop cam ready — press Q to quit")

# ── Main Loop ───────────────────────────────────────────────
while True:
    ret, img = cap.read()
    if not ret:
        continue

    img = cv2.flip(img, 1)                          # Mirror image

    # Detect hands
    img = detector.findHands(img, draw=True)
    lmList, bbox = detector.findPosition(img, draw=False)

    # Draw region of interest rectangle
    cv2.rectangle(img,
                  (frameR, frameR),
                  (wCam - frameR, hCam - frameR),
                  (0, 255, 65), 1)

    scolor = (0, 255, 0)   # default border color

    if len(lmList) != 0:
        # Wrist landmark (index 0)
        x = lmList[0][1]
        y = lmList[0][2]

        # Map position → servo angles
        pan_raw  = np.interp(x, (frameR, wCam - frameR), (PAN_MIN,  PAN_MAX))
        tilt_raw = np.interp(y, (frameR, hCam - frameR), (TILT_MIN, TILT_MAX))

        # Exponential smoothing
        plocX = plocX + ALPHA * (pan_raw  - plocX)
        plocY = plocY + ALPHA * (tilt_raw - plocY)

        # Quantize to 0.5° steps
        clocX = round(plocX * 2) / 2
        clocY = round(plocY * 2) / 2

        # Clamp within safe limits
        clocX = max(PAN_MIN,  min(PAN_MAX,  clocX))
        clocY = max(TILT_MIN, min(TILT_MAX, clocY))

        # Update shared state for WebSocket thread
        with servo_lock:
            latest_pan  = clocX
            latest_tilt = clocY

        # Draw hand marker
        cv2.circle(img, (x, y), 15, (0, 255, 65), cv2.FILLED)
        cv2.circle(img, (x, y),  5, (0,   0,  0), cv2.FILLED)

        # Line from center to hand
        cv2.line(img, (wCam // 2, hCam // 2), (x, y), (0, 180, 40), 1)

        status = f"PAN {int(clocX):3d}  TILT {int(clocY):3d}"
        scolor = (0, 255, 65)

    else:
        status = "NO HAND"
        scolor = (0, 0, 255)

    # FPS calculation
    cTime = time.time()
    fps   = 1 / (cTime - pTime) if pTime else 0
    pTime = cTime

    # Overlay text
    cv2.putText(img, f"FPS {int(fps)}",
                (10, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (200, 200, 200), 2)
    cv2.putText(img, status,
                (10, 65), cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 255, 65), 2)

    # Border
    cv2.rectangle(img, (0, 0), (wCam - 1, hCam - 1), scolor, 2)

    cv2.imshow("ADS-1 Hand Tracker", img)

    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

# ── Cleanup ─────────────────────────────────────────────────
cap.release()
cv2.destroyAllWindows()
print("[SYS] Stopped")